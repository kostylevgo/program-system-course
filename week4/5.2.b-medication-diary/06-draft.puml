@startuml
title Ежедневник приёма лекарств — черновик этапа 6
top to bottom direction
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName SansSerif
skinparam linetype ortho
hide empty members

class "Ежедневник" as Diary {
  - id: Идентификатор
  - пациент: Текст
  + записатьРецепт(данные): Рецепт
  + приёмыНаДату(дата): ПриёмЛекарства[0..*]
}

class "Рецепт" as Prescription {
  - id: Идентификатор
  - датаВыдачи: Дата
  - врач: Текст
  - болезнь: Текст
  + уточнитьРеквизиты(данные): void
  + добавитьНазначение(данные): Назначение
}

class "Назначение" as Regimen {
  - id: Идентификатор
  - лекарство: Текст
  - доза: Текст
  - начало: Дата
  - конец: Дата
  - времена: Множество<Время>
  + исправить(данные): void
  + составитьПлан(): ПриёмЛекарства[0..*]
}

class "ПриёмЛекарства" as Intake {
  - id: Идентификатор
  - плановоеВремя: ДатаВремя
  - статус: Текст
  - фактическоеВремя: ДатаВремя [0..1]
  + отметитьПринятым(время): void
  + отметитьПропущенным(): void
  + сброситьОтметку(): void
}

Diary "1\nежедневник" *-- "0..*\nрецепты" Prescription : хранитРецепты
Prescription "1\nрецепт" *-- "1..*\nназначения" Regimen : содержитНазначения
Regimen "1\nназначение" *-- "0..*\nприёмы" Intake : планируетПриёмы

legend bottom
  R1 — получение рецепта; R2 — ежедневник.
  Структура и кратности уточнены допущениями A1–A8.
  Рецепт обозначает локальную запись полученного документа.
  Аргумент «данные» раскрыт в 05-relations.md.
endlegend
@enduml
