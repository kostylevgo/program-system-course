@startuml
title CRM — акторы и варианты использования
left to right direction
skinparam shadowing false
skinparam backgroundColor white
skinparam packageStyle rectangle

actor "Менеджер\nпо продажам" as SalesManagerActor
actor "Клиент" as ClientActor
actor "Руководитель\nотдела" as DepartmentHeadActor

rectangle "Система управления клиентами (CRM)" {
  usecase "Управление карточками клиентов\nManageClients" as ManageClients
  usecase "Обработка заявки\nProcessNote" as ProcessNote
  usecase "Проведение сделки\nConductDeal" as ConductDeal
  usecase "Подготовка отчёта\nPrepareReport" as PrepareReport
}

SalesManagerActor -- ManageClients
SalesManagerActor -- ProcessNote
SalesManagerActor -- ConductDeal
ClientActor -- ProcessNote
ClientActor -- ConductDeal
DepartmentHeadActor -- PrepareReport

note bottom of PrepareReport
  Отчёт готовит руководитель отдела (R5).
  Остальные функции использует менеджер (R5).
  Клиент участвует в заявке и сделке (R6).
  include, extend и наследование акторов
  не следуют из условия.
end note
@enduml
